# ============================================================
# CONTENT ENGINE — ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================================

# ─── Database ───
DB_USER=contentengine
DB_PASSWORD=your-strong-password-here

# ─── n8n ───
N8N_USER=admin
N8N_PASSWORD=your-n8n-password
N8N_HOST=n8n.yourdomain.com
WEBHOOK_BASE_URL=https://n8n.yourdomain.com

# ─── API Server ───
JWT_SECRET=generate-a-random-64-char-string
API_URL=https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
DASHBOARD_URL=https://app.yourdomain.com
PORT=3001

# ─── AI Services ───
ANTHROPIC_API_KEY=sk-ant-...
FAL_API_KEY=your-fal-ai-key
GEMINI_API_KEY=your-gemini-api-key

# ─── File Storage (Cloudflare R2 or AWS S3) ───
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=content-engine
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_PUBLIC_URL=https://cdn.yourdomain.com

# ─── OAuth: Facebook / Instagram (same app) ───
# Create at: https://developers.facebook.com
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ─── OAuth: LinkedIn ───
# Create at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ─── OAuth: TikTok ───
# Create at: https://developers.tiktok.com
TIKTOK_CLIENT_ID=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ─── OAuth: YouTube (Google) ───
# Create at: https://console.cloud.google.com
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret

# ─── OAuth: X / Twitter ───
# X uses OAuth 1.0a stored per-business in platform_credentials.
# No client ID/secret needed at env level — tokens are configured per business.
# Create app at: https://developer.x.com

# ─── Alex Integration ───
# Alex webhook URL is configured per-business in the dashboard.
# No env vars needed — Alex uses the same JWT_SECRET for auth.
